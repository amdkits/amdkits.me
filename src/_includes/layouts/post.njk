<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="description" content="{{ description or site.description }}"><link rel="icon" href="/favicon.ico"><title>amdkits — {{ title }}</title><link rel="stylesheet" href="/styles.css"></head><body class="post-body"><div id="oneko"></div><script src="/oneko.js"></script>{% include "components/music.njk" %}<main class="post"><a class="post-back" href="/">← back home?</a><header class="post-header"><span class="post-tag">[{{ tag or 'note' }}]</span><h1 class="post-title">{{ title }}</h1>{% if date %}<span class="post-date">{{ date }}</span>{% endif %}</header>{% if youtubeId %}<div class="video"><iframe src="https://www.youtube.com/embed/{{ youtubeId }}" title="{{ title }}" loading="lazy" allowfullscreen></iframe></div>{% endif %}<article class="post-content">{{ content | safe }}</article></main></body></html>
