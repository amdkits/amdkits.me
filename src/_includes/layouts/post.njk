<!doctype html>
<html lang='en'>
  <head>
    {% include "components/head.njk" %}
  </head>
  <body>
    <div id='oneko'></div>
    <script src='/oneko.js'></script>
    {% include "components/music.njk" %}
    {% include "components/sidebar.njk" %}
    {% include "components/friends.njk" %}
    <main id='site-content' class='post'>
      <a class='post-back' href='{{ backHref or "/" }}'>{{ backLabel or "← back home?" }}</a>
      <header class='post-header'>
        <span class='post-tag'>[{{ tag or 'note' }}]</span>
        <h1 class='post-title'>{{ title }}</h1>
        {% if date %}
          <span class='post-date'>
            {{ date }}
          </span>
        {% endif %}
      </header>
      {% if youtubeId %}
        <div class='video'>
          <iframe
            src='https://www.youtube.com/embed/{{ youtubeId }}'
            title='{{ title }}'
            loading='lazy'
            allowfullscreen
          ></iframe>
        </div>
      {% endif %}
      <article class='post-content'>{{ content | safe }}</article>
    </main>
    <script src='/navigation.js'></script>
  </body>
</html>
