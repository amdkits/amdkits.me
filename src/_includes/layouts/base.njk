<!doctype html>
<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <meta name='description' content='{{ site.description }}' />
    <link rel='icon' href='/favicon.ico' />
    <link
      rel='alternate'
      type='application/rss+xml'
      title='amdkits'
      href='/rss.xml'
    />
    <title>amdkits — {{ title }}</title>
    <link rel='stylesheet' href='/styles.css' />
  </head>
  <body>
    <div id='oneko'></div>
    <script src='/oneko.js'></script>
    {% include "components/music.njk" %}
    {% include "components/sidebar.njk" %}
    {% include "components/friends.njk" %}
    <div class='page'>
      <div class='box'>
        <div class='hero'>
          <a class='ascii-link' href='/'>
            <pre
              class='ascii-logo'
            > ▄▄▄· • ▌ ▄ ·. ·▄▄▄▄  ▄ •▄ ▪  ▄▄▄▄▄.▄▄ · 
▐█ ▀█ ·██ ▐███▪██▪ ██ █▌▄▌▪██ •██  ▐█ ▀. 
▄█▀▀█ ▐█ ▌▐▌▐█·▐█· ▐█▌▐▀▀▄·▐█· ▐█.▪▄▀▀▀█▄
▐█ ▪▐▌██ ██▌▐█▌██. ██ ▐█.█▌▐█▌ ▐█▌·▐█▄▪▐█
 ▀  ▀ ▀▀  █▪▀▀▀▀▀▀▀▀• ·▀  ▀▀▀▀ ▀▀▀  ▀▀▀▀ </pre>
          </a>
        </div>
        <div class='window'>
          <div class='titlebar'>⛩️ El, Psy, Congroo</div>
          <div class='navbar'>
            <nav class='navrow'>
              {% for item in site.nav %}
                <a href='{{ item[0] }}'>
                  {{ item[1] }}
                </a>
              {% endfor %}
            </nav>
          </div>
          {{ content | safe }}
        </div>
      </div>
    </div>
  </body>
</html>
