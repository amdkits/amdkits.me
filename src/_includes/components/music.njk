<div
  id='music-player'
  class='music-player'
  data-playlist='{{ site.music | dump | safe }}'
>
  <audio id='bg-audio' preload='metadata'></audio>

  <div class='music-row'>
    <button id='music-prev' type='button' aria-label='Previous song'>«</button>

    <button id='music-toggle' type='button' aria-label='Play music'>▶</button>

    <button id='music-next' type='button' aria-label='Next song'>»</button>

    <button id='music-mute' type='button' aria-label='Mute music'>♪</button>

    <span id='music-title'></span>
  </div>

  <input
    id='music-progress'
    class='music-progress'
    type='range'
    min='0'
    max='100'
    value='0'
    step='0.1'
    aria-label='Song progress'
  />
</div>

<script src='/music.js' defer></script>
