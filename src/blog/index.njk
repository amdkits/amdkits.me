---
layout: layouts/base.njk
title: blog
permalink: /blog/
---
<section class='content page-content'>
  <h1>blog</h1>
  <ul class='feed'>
    {% for post in collections.posts %}
      <li>
        <span class='date'>{{ post.data.date }}</span>
        <span class='sep'>·</span>
        <a href='{{ post.url }}'>
          <span class='tag'>[{{ post.data.tag or 'note' }}]</span>
          <span class='label'>{{ post.data.title }}</span>
        </a>
      </li>
    {% else %}
      <li>
        <span class='label'>nothing here yet.</span>
      </li>
    {% endfor %}
  </ul>
</section>
